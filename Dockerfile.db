# Data-only container — holds all persistent user data.
# Rebuild or replace the `app` container freely; this container
# and its named volumes keep database, uploads, and TLS certs safe.
FROM node:20-slim

RUN mkdir -p /userdata/db /userdata/uploads /userdata/certs

VOLUME ["/userdata/db", "/userdata/uploads", "/userdata/certs"]

CMD ["sh", "-c", "trap : TERM INT; while true; do sleep 3600; done"]
