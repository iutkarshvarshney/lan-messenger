# Set independent, random secrets before starting Docker Compose.
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret
ADMIN_PANEL_PASSWORD=replace-with-a-private-control-panel-password
# Optional for initial HTTPS certificate generation on the server:
# SERVER_IP=192.168.1.100

# Optional: restrict web SSH to specific LAN networks (comma-separated CIDRs).
# Default: RFC1918 private IPv4 networks; only SSH port 22.
# WEB_TERMINAL_CIDRS=10.229.40.0/24
# WEB_TERMINAL_PORTS=22
